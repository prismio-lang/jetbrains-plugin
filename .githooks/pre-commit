#!/bin/sh
# graphify-out/ is tracked, and a refreshed one is not committed until the maintainer says so:
# graph.json and graph.html change on every `graphify update .`, so a commit per refresh would
# bloat the history. Staging it is refused; to commit one deliberately:
#
#     PRISMIO_ALLOW_GRAPH_COMMIT=1 git commit ...
#
# Enable the hooks in a clone with:  git config core.hooksPath .githooks

if [ "${PRISMIO_ALLOW_GRAPH_COMMIT:-}" = "1" ]; then exit 0; fi

graph=$(git diff --cached --name-only --diff-filter=ACMRD | grep -E '(^|/)graphify-out/' || true)
if [ -n "$graph" ]; then
    echo "error: graphify-out is staged, and a refreshed graph is not committed until the maintainer says so:" >&2
    echo "$graph" | sed 's/^/    /' >&2
    echo "unstage it with: git restore --staged <file>" >&2
    echo "(to commit one on purpose: PRISMIO_ALLOW_GRAPH_COMMIT=1 git commit ...)" >&2
    exit 1
fi
