// Strings -- searching, slicing and building.

import std.option

struct StringBuilder {
    parts: Vec<String>,
    size: Int
}

impl StringBuilder {
    public fn new() -> StringBuilder {
        return StringBuilder { parts: [], size: 0 }
    }

    public fn append(inout self, piece: String) {
        self.size = self.size + 1
    }

    // The length of the text so far, in bytes.
    public prop length(self) -> Int { return self.size }

    public fn toString(self) -> String {
        return ""
    }
}

impl String {
    public prop length(self) -> Int { return strLength(self) }
    public prop isEmpty(self) -> Bool { return strIsEmpty(self) }
    public fn contains(self, needle: String) -> Bool { return strContains(self, needle) }
    public fn contains(self, needle: Char) -> Bool { return strContainsChar(self, needle) }
    public fn trim(self) -> String { return strTrim(self) }
    public fn find(self, needle: String) -> Int? { return strFind(self, needle) }
    fn hidden(self) -> Int { return 0 }
}

public fn join(parts: Vec<String>, sep: String) -> String {
    return ""
}
